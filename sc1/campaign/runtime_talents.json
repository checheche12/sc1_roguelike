    {
      "id": "481876a7-e041-567c-91c0-dbbe5915acaf",
      "byte_index": 0,
      "name": "끝없는 증원",
      "effect": {
        "type": "wave_count",
        "numerator_per_stack": 1,
        "denominator": 4
      },
